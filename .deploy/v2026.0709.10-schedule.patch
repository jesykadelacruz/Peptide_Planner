+function normalisedScheduleDays(days){
+  return [...new Set((days||[]).map(Number).filter(day=>day>=0&&day<=6))].sort((a,b)=>a-b);
+}
+function effectiveCycleSchedule(config,week=1){
+  if(!config)return null;
+  const phase=cyclePhaseForWeek(config,week);
+  const phaseDays=normalisedScheduleDays(phase?.weekdays);
+  if(phaseDays.length)return {scheduleMode:"weekdays",weekdays:phaseDays,intervalDays:""};
+  const phaseInterval=enteredPlanNumber(phase?.intervalDays);
+  if(phaseInterval!=null&&phaseInterval>0)return {scheduleMode:"interval",weekdays:[],intervalDays:Math.max(1,Math.floor(phaseInterval))};
+  return {
+    scheduleMode:config.scheduleMode==="interval"?"interval":"weekdays",
+    weekdays:normalisedScheduleDays(config.weekdays),
+    intervalDays:config.intervalDays??""
+  };
+}
