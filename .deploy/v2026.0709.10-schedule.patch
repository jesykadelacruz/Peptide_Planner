+}
+function applyCycleSchedulePreset(config,preset){
+  if(!config)return;
+  const current=effectiveCycleSchedule(config,1);
+  let scheduleMode="weekdays",weekdays=[],intervalDays="";
+  if(preset==="daily")weekdays=[0,1,2,3,4,5,6];
